/**
 * bridge.js — Claude API 브릿지
 *
 * 우선순위:
 *  1. 실기기(Capacitor)   → ClaudePlugin.kt (OkHttp + EncryptedSharedPreferences)
 *  2. PC 브라우저         → fetch()로 Anthropic API 직접 호출 (CORS: anthropic-dangerous-direct-browser-access)
 */

const IS_CAPACITOR = typeof window.Capacitor !== 'undefined' &&
                     window.Capacitor.isNativePlatform();

// ── PC 브라우저 전용: Anthropic API 직접 호출 ────────────────────────────
const _pcBridge = {
  _tokenListeners: [],
  _stopRequested: false,
  _reader: null,

  getApiKey() {
    return localStorage.getItem('claude_api_key')
        || 'YOUR_ANTHROPIC_API_KEY_HERE';
  },

  /** SSE 스트리밍 추론 */
  async streamGenerate({ prompt, history, imageBase64, imageMediaType, maxTokens, language, systemPrompt }) {
    this._stopRequested = false;

    const apiKey = this.getApiKey();
    if (!apiKey) {
      this._emit({ error: 'API Key가 설정되지 않았습니다.', done: true });
      return;
    }

    // ── messages 배열 구성 ──────────────────────────────────────────────
    const messages = [];

    // 히스토리 (최근 20턴)
    const hist = (history || []).slice(-40); // role/content 쌍이라 ×2
    for (const h of hist) {
      if (!h.role || !h.content) continue;
      const role = h.role === 'model' ? 'assistant' : h.role;
      messages.push({ role, content: h.content });
    }

    // 현재 사용자 메시지
    if (imageBase64) {
      const mediaType = imageMediaType || 'image/jpeg';
      messages.push({
        role: 'user',
        content: [
          { type: 'image', source: { type: 'base64', media_type: mediaType, data: imageBase64 } },
          { type: 'text', text: prompt || '이 이미지를 분석해줘' }
        ]
      });
    } else {
      messages.push({ role: 'user', content: prompt });
    }

    // ── 시스템 프롬프트 ─────────────────────────────────────────────────
    // 호출자가 직접 지정한 systemPrompt 우선, 없으면 언어 기본값
    const resolvedSystem = systemPrompt || (
      (language === 'en')   ? 'Please answer in English.' :
      (language === 'auto') ? 'Please answer in the same language as the user.' :
                              '한국어로 답변하세요.'
    );

    const body = {
      model: 'claude-sonnet-4-5',
      max_tokens: maxTokens || 4096,
      stream: true,
      system: resolvedSystem,
      messages
    };

    let resp;
    try {
      resp = await fetch('https://api.anthropic.com/v1/messages', {
        method: 'POST',
        headers: {
          'x-api-key': apiKey,
          'anthropic-version': '2023-06-01',
          'content-type': 'application/json',
          'anthropic-dangerous-direct-browser-access': 'true'
        },
        body: JSON.stringify(body)
      });
    } catch (err) {
      this._emit({ error: '네트워크 오류: ' + err.message, done: true });
      return;
    }

    if (!resp.ok) {
      let msg = `API 오류 (${resp.status})`;
      try {
        const j = await resp.json();
        msg = j?.error?.message || msg;
        if (resp.status === 401) msg = '유효하지 않은 API Key입니다.';
        if (resp.status === 429) msg = '요청 한도(Rate Limit)에 도달했습니다. 잠시 후 다시 시도하세요.';
      } catch {}
      this._emit({ error: msg, done: true });
      return;
    }

    // ── SSE 파싱 ────────────────────────────────────────────────────────
    this._reader = resp.body.getReader();
    const decoder = new TextDecoder();
    let buf = '';

    try {
      while (true) {
        if (this._stopRequested) break;
        const { done, value } = await this._reader.read();
        if (done) break;

        buf += decoder.decode(value, { stream: true });
        const lines = buf.split('\n');
        buf = lines.pop(); // 미완성 줄은 다음 청크로

        for (const line of lines) {
          if (!line.startsWith('data:')) continue;
          const data = line.slice(5).trim();
          if (!data || data === '[DONE]') continue;
          try {
            const obj = JSON.parse(data);
            if (obj.type === 'content_block_delta' && obj.delta?.type === 'text_delta') {
              this._emit({ token: obj.delta.text, done: false });
            } else if (obj.type === 'message_stop') {
              this._emit({ token: null, done: true });
              return;
            } else if (obj.type === 'error') {
              this._emit({ error: obj.error?.message || '스트리밍 오류', done: true });
              return;
            }
          } catch {}
        }
      }
    } finally {
      try { this._reader?.cancel(); } catch {}
      this._reader = null;
    }

    this._emit({ token: null, done: true });
  },

  stop() {
    this._stopRequested = true;
    try { this._reader?.cancel(); } catch {}
  },

  _emit(data) {
    this._tokenListeners.forEach(fn => fn(data));
  }
};

// ── 공개 API ─────────────────────────────────────────────────────────────
const ClaudeBridge = {

  // ── 이벤트 리스너 ─────────────────────────────────────────────────────
  _listeners: {},

  addListener(event, callback) {
    if (IS_CAPACITOR) {
      return window.Capacitor.Plugins.ClaudePlugin.addListener(event, callback);
    }
    if (!this._listeners[event]) this._listeners[event] = [];
    this._listeners[event].push(callback);
    if (event === 'onToken') _pcBridge._tokenListeners.push(callback);
    return {
      remove: () => {
        this._listeners[event] = (this._listeners[event] || []).filter(fn => fn !== callback);
        if (event === 'onToken')
          _pcBridge._tokenListeners = _pcBridge._tokenListeners.filter(fn => fn !== callback);
      }
    };
  },

  _emit(event, data) {
    (this._listeners[event] || []).forEach(fn => fn(data));
  },

  // ── 추론 요청 ──────────────────────────────────────────────────────────
  async generate(opts) {
    if (IS_CAPACITOR) {
      return await window.Capacitor.Plugins.ClaudePlugin.generate(opts);
    }
    // PC 브라우저: 직접 API 호출 (비동기 — 결과는 onToken 이벤트로 전달)
    _pcBridge.streamGenerate(opts).catch(err => {
      _pcBridge._emit({ error: err.message || '알 수 없는 오류', done: true });
    });
    return { success: true };
  },

  // ── 생성 중단 ──────────────────────────────────────────────────────────
  async stopGeneration() {
    if (IS_CAPACITOR) {
      return await window.Capacitor.Plugins.ClaudePlugin.stopGeneration();
    }
    _pcBridge.stop();
    return { success: true };
  },

  // ── PDF 보고서 생성 (Android 전용) ──────────────────────────────────────
  async generatePdf(params) {
    if (IS_CAPACITOR) {
      return await window.Capacitor.Plugins.ClaudePlugin.generatePdf(params);
    }
    throw new Error('PDF 저장은 Android 앱에서만 지원됩니다.');
  }
};

window.ClaudeBridge = ClaudeBridge;
window.IS_CAPACITOR = IS_CAPACITOR;
